[
  {
    "label": "Echo runnable context (checks the wiring)",
    "command": "echo",
    "args": ["story=$ZED_FILE scenario=$ZED_CUSTOM_NAME row=$ZED_ROW"],
    "tags": ["jbehave-scenario"]
  },
  {
    "label": "Run scenario: $ZED_CUSTOM_NAME",
    "command": "mvn",
    "args": [
      "-pl",
      "<module>",
      "test",
      "-Dtest=<StoriesClass>",
      "-DmetaFilters=+scenario_title \"$ZED_CUSTOM_NAME\""
    ],
    "tags": ["jbehave-scenario"]
  }
]
